---
import { seriesUrl, type Channel } from "../lib/data";

interface Props { c: Channel }
const { c } = Astro.props;
const noted = c.series.filter((s) => s.lessons.some((l) => l.has_note));
const sutraName = (s: string | null) => s?.match(/《([^》]+)》/)?.[1] ?? null;
---
<div class="cards">
  {noted.map((s) => (
    <a class="card" href={seriesUrl(c, s)}>
      <h3>{s.name}</h3>
      <p>{s.lessons.filter((l) => l.has_note).length} 講{sutraName(s.home_sutra) && sutraName(s.home_sutra) !== s.name ? `・《${sutraName(s.home_sutra)}》` : ""}{s.home_sutra_id ? `・${s.home_sutra_id}` : ""}</p>
    </a>
  ))}
</div>
