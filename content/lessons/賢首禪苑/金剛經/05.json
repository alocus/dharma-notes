{
 "proof": [
  {
   "text": "應云何住云何降伏其心",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": null
  },
  {
   "text": "善哉善哉應如是住如是降伏其心",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": null
  },
  {
   "text": "若有色若無色我皆令入無餘涅槃而滅度之即非菩薩",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": null
  },
  {
   "text": "菩薩於法應無所住行於布施其福德不可思量",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": null
  },
  {
   "text": "東方虛空可思量不但應如所教住",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": null
  },
  {
   "text": "可以身相見如來不即非身相",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": null
  },
  {
   "text": "凡所有相皆是虛妄若見諸相非相則見如來",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": null
  },
  {
   "text": "頗有眾生得聞如是言說章句生實信不",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": null
  },
  {
   "text": "莫作是說如來滅後後五百歲有持戒修福者已於無量千萬佛所種諸善根",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": null
  },
  {
   "text": "乃至一念生淨信者得如是無量福德無復我相人相眾生相壽者相",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": null
  },
  {
   "text": "無法相亦無非法相是故不應取法不應取非法",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": null
  },
  {
   "text": "如筏喻者法尚應捨何況非法",
   "attrib": "金剛經",
   "cbeta": "T0235",
   "line": null
  },
  {
   "text": "廣大第一常其心不顛倒利益深心住此乘功德滿",
   "attrib": "彌勒偈",
   "cbeta": "T1511",
   "line": null
  },
  {
   "text": "惠能言下大悟何期自性本自清淨",
   "attrib": "六祖壇經",
   "cbeta": "T2008",
   "line": null
  },
  {
   "text": "真正見道人不看世間過",
   "attrib": "六祖壇經",
   "cbeta": "T2008",
   "line": null
  },
  {
   "text": "觀自在菩薩色即是空空即是色",
   "attrib": "心經",
   "cbeta": "T0251",
   "line": null
  },
  {
   "text": "因緣所生法我說即是空亦名為假名亦是中道義",
   "attrib": "中論",
   "cbeta": "T1564",
   "line": null
  },
  {
   "text": "妄認四大為自身相六塵緣影為自心相第二月",
   "attrib": "圓覺經",
   "cbeta": "T0842",
   "line": null
  },
  {
   "text": "悟淨圓覺以淨覺心奢摩他三摩鉢提禪那",
   "attrib": "圓覺經",
   "cbeta": "T0842",
   "line": null
  },
  {
   "text": "汝身汝心皆是妙明真精妙心中所現物",
   "attrib": "楞嚴經",
   "cbeta": "T0945",
   "line": null
  },
  {
   "text": "淨業三福孝養父母奉事師長慈心不殺修十善業受持三歸具足眾戒不犯威儀發菩提心深信因果讀誦大乘勸進行者",
   "attrib": "觀無量壽佛經",
   "cbeta": "T0365",
   "line": null
  },
  {
   "text": "心鏡明鑑無礙廓然瑩徹周沙界萬象森羅影現中一顆圓光非內外",
   "attrib": "永嘉證道歌",
   "cbeta": "T2014",
   "line": null
  },
  {
   "text": "兩者猶如鏡上痕",
   "attrib": "永嘉證道歌",
   "cbeta": "T2014",
   "line": null
  },
  {
   "text": "覺即了不施功",
   "attrib": "永嘉證道歌",
   "cbeta": "T2014",
   "line": null
  },
  {
   "text": "鏡裏看形見不難水中捉月爭拈得",
   "attrib": "永嘉證道歌",
   "cbeta": "T2014",
   "line": null
  },
  {
   "text": "豁達空撥因果莽莽蕩蕩招殃禍棄有著空病亦然猶如避溺而投火",
   "attrib": "永嘉證道歌",
   "cbeta": "T2014",
   "line": null
  },
  {
   "text": "去聖遠兮邪見深魔強法弱多怨害聞說如來頓教門恨不滅除令瓦碎",
   "attrib": "永嘉證道歌",
   "cbeta": "T2014",
   "line": null
  },
  {
   "text": "四事供養何辭勞粉骨碎身何足酬",
   "attrib": "永嘉證道歌",
   "cbeta": "T2014",
   "line": null
  },
  {
   "text": "解脫堅固禪定堅固多聞堅固塔寺堅固鬥諍堅固",
   "attrib": "大集經月藏分",
   "cbeta": "T0397",
   "line": null
  },
  {
   "text": "若人欲了知三世一切佛應觀法界性一切唯心造",
   "attrib": "華嚴覺林偈",
   "cbeta": "T0279",
   "line": null
  },
  {
   "text": "大慧108問佛珠108顆",
   "attrib": "楞伽經",
   "cbeta": "T0670",
   "line": null
  }
 ],
