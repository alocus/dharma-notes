{
 "proof": [
  {
   "text": "一切有為法如夢幻泡影如露亦如電應作如是觀",
   "attrib": "金剛經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "凡所有相皆是虛妄",
   "attrib": "金剛經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "云何為人演說不取於相如如不動",
   "attrib": "金剛經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "應無所住而生其心",
   "attrib": "金剛經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "唯有一乘法無二亦無三",
   "attrib": "法華經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "先以欲鉤牽後令入佛智",
   "attrib": "維摩",
   "cbeta": null,
   "line": null
  },
  {
   "text": "色即是空空即是色",
   "attrib": "心經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "若人欲了知三世一切佛應觀法界性一切唯心造",
   "attrib": "華嚴",
   "cbeta": null,
   "line": null
  },
  {
   "text": "心佛及眾生是三無差別",
   "attrib": "華嚴",
   "cbeta": null,
   "line": null
  },
  {
   "text": "有大智慧光明義故遍照法界義故真實識知義故自性清淨心義故",
   "attrib": "起信論",
   "cbeta": null,
   "line": null
  },
  {
   "text": "憶佛念佛現前當來必定見佛",
   "attrib": "楞嚴",
   "cbeta": null,
   "line": null
  },
  {
   "text": "不假方便自得心開",
   "attrib": "楞嚴",
   "cbeta": null,
   "line": null
  },
  {
   "text": "都攝六根淨念相繼得三摩地斯為第一",
   "attrib": "楞嚴",
   "cbeta": null,
   "line": null
  },
  {
   "text": "若能轉物則同如來",
   "attrib": "楞嚴",
   "cbeta": null,
   "line": null
  },
  {
   "text": "慈悲即是觀音喜捨名為勢至能淨即釋迦平直即彌陀",
   "attrib": "六祖壇經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "天明祖喚盧供奉來...依此偈修有大利益",
   "attrib": "六祖壇經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "身是菩提樹心如明鏡臺時時勤拂拭莫使有塵埃/菩提本無樹明鏡亦非臺本來無一物何處惹塵埃",
   "attrib": "六祖壇經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "無明實性即佛性",
   "attrib": "永嘉證道歌",
   "cbeta": null,
   "line": null
  },
  {
   "text": "此有故彼有此生故彼生",
   "attrib": "阿含緣起",
   "cbeta": null,
   "line": null
  },
  {
   "text": "名龍樹菩薩能破有無見/厥號為龍樹能破有無宗",
   "attrib": "楞伽",
   "cbeta": null,
   "line": null
  },
  {
   "text": "生因依因習因",
   "attrib": "成實論",
   "cbeta": null,
   "line": null
  },
  {
   "text": "離經一字即同魔說",
   "attrib": "法師稱楞嚴",
   "cbeta": null,
   "line": null
  }
 ],
