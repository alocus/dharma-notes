{
 "proof": [
  {
   "text": "此菩薩及末世眾生修習此心得成就者…一切法性平等不壞",
   "attrib": "圓覺經·普眼章",
   "cbeta": null,
   "line": null
  },
  {
   "text": "普眼汝當知，一切諸眾生，身心皆如幻…",
   "attrib": "圓覺經·普眼章偈",
   "cbeta": null,
   "line": null
  },
  {
   "text": "一切世界始終生滅…是故汝等便生三惑",
   "attrib": "圓覺經·金剛藏章",
   "cbeta": null,
   "line": null
  },
  {
   "text": "無上法王有大陀羅尼門，名為圓覺，流出一切清淨真如菩提涅槃及波羅蜜教授菩薩。",
   "attrib": "圓覺經·文殊章",
   "cbeta": null,
   "line": null
  },
  {
   "text": "妄認四大為自身相，六塵緣影為自心相",
   "attrib": "圓覺經·文殊章",
   "cbeta": null,
   "line": null
  },
  {
   "text": "幻身滅故幻心亦滅…非幻不滅",
   "attrib": "圓覺經·普眼章",
   "cbeta": null,
   "line": null
  },
  {
   "text": "對離幻垢說名菩薩…彼愚癡者",
   "attrib": "圓覺經·普眼章",
   "cbeta": null,
   "line": null
  },
  {
   "text": "若諸眾生本來成佛…何時復生一切煩惱",
   "attrib": "圓覺經·金剛藏章",
   "cbeta": null,
   "line": null
  },
  {
   "text": "照見五蘊皆空，度一切苦厄",
   "attrib": "心經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "色不異空，空不異色，色即是空，空即是色",
   "attrib": "心經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "無智，亦無得",
   "attrib": "心經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "如來所得法，此法無實無虛…見種種色",
   "attrib": "金剛經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "一切有為法，如夢幻泡影，如露亦如電，應作如是觀",
   "attrib": "金剛經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "應無所住而生其心",
   "attrib": "金剛經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "爾時多寶佛於寶塔中分半座與釋迦牟尼佛",
   "attrib": "法華經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "不是風動，不是旛動，仁者心動",
   "attrib": "六祖壇經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "如人飲水，冷暖自知",
   "attrib": "六祖壇經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "何期自性，本自清淨…能生萬法",
   "attrib": "六祖壇經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "若人欲了知，三世一切佛，應觀法界性，一切唯心造",
   "attrib": "華嚴經(80)",
   "cbeta": null,
   "line": null
  },
  {
   "text": "菩薩摩訶薩應知自心念念常有佛成正覺",
   "attrib": "華嚴經(80)",
   "cbeta": null,
   "line": null
  },
  {
   "text": "心佛及眾生，是三無差別",
   "attrib": "華嚴經(60)",
   "cbeta": null,
   "line": null
  },
  {
   "text": "心是根，法是塵，兩種猶如鏡上痕",
   "attrib": "永嘉證道歌",
   "cbeta": null,
   "line": null
  },
  {
   "text": "無明實性即佛性，幻化空身即法身",
   "attrib": "永嘉證道歌",
   "cbeta": null,
   "line": null
  },
  {
   "text": "覺即了不施功",
   "attrib": "永嘉證道歌",
   "cbeta": null,
   "line": null
  },
  {
   "text": "報化非真佛，亦非說法者",
   "attrib": "黃檗傳心法要",
   "cbeta": null,
   "line": null
  },
  {
   "text": "我今示汝不生滅性（波斯匿王）",
   "attrib": "楞嚴經卷二",
   "cbeta": null,
   "line": null
  },
  {
   "text": "了本識心…是心是佛，是佛是心，念念佛心",
   "attrib": "傅大士心王銘/景德傳燈錄",
   "cbeta": null,
   "line": null
  },
  {
   "text": "空手把鋤頭，步行騎水牛，人從橋上過，橋流水不流",
   "attrib": "景德傳燈錄",
   "cbeta": null,
   "line": null
  },
  {
   "text": "先以欲鉤牽，後令入佛智",
   "attrib": "維摩詰所說經",
   "cbeta": null,
   "line": null
  }
 ],
