{
 "proof": [
  {
   "text": "如來因地修圓覺者知是空花…不墮邪見",
   "attrib": "",
   "cbeta": "T0842",
   "line": 335
  },
  {
   "text": "文殊汝當知…修此免邪見（偈頌）",
   "attrib": "",
   "cbeta": "T0842",
   "line": 823
  },
  {
   "text": "是則名為淨覺隨順",
   "attrib": "",
   "cbeta": "T0842",
   "line": 343
  },
  {
   "text": "不思善不思惡…本來面目",
   "attrib": "",
   "cbeta": "T2008",
   "line": 562
  },
  {
   "text": "陰是五陰…名含藏識",
   "attrib": "",
   "cbeta": "T2008",
   "line": 628
  },
  {
   "text": "臥輪偈/六祖偈",
   "attrib": "",
   "cbeta": "T2008",
   "line": 404
  },
  {
   "text": "神秀偈/惠能偈",
   "attrib": "",
   "cbeta": "T2008",
   "line": 445
  },
  {
   "text": "歌利王割截身體無四相",
   "attrib": "",
   "cbeta": "T0235",
   "line": 711
  },
  {
   "text": "應無所住而生其心",
   "attrib": "",
   "cbeta": "T0235",
   "line": 411
  },
  {
   "text": "若見諸相非相即見如來",
   "attrib": "",
   "cbeta": "T0235",
   "line": 358
  },
  {
   "text": "觀自在菩薩行深般若…色不異空",
   "attrib": "",
   "cbeta": "T0251",
   "line": 837
  },
  {
   "text": "無無明亦無無明盡",
   "attrib": "",
   "cbeta": "T0251",
   "line": 857
  },
  {
   "text": "知見立知即無明本",
   "attrib": "",
   "cbeta": "T0945",
   "line": 792
  },
  {
   "text": "是心作佛是心是佛",
   "attrib": "",
   "cbeta": "T0365",
   "line": 308
  },
  {
   "text": "應觀法界性一切唯心造",
   "attrib": "",
   "cbeta": "T0279",
   "line": 310
  },
  {
   "text": "其性本清淨開示諸群生",
   "attrib": "",
   "cbeta": "T0279",
   "line": 684
  },
  {
   "text": "鏡裏看形見不難水中捉月爭拈得",
   "attrib": "",
   "cbeta": "T2014",
   "line": 358
  },
  {
   "text": "不見一法即如來方得名為觀自在",
   "attrib": "",
   "cbeta": "T2014",
   "line": 936
  },
  {
   "text": "了了見無一物亦無人亦無佛",
   "attrib": "",
   "cbeta": "T2014",
   "line": 934
  },
  {
   "text": "觀世音南無佛…念念不離心（十句）",
   "attrib": "",
   "cbeta": "T2035",
   "line": 932
  }
 ],
