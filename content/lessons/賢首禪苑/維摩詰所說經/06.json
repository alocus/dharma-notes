{
 "proof": [
  {
   "text": "諸菩薩摩訶薩應如是降伏其心…實無眾生得滅度者",
   "attrib": "T0235 金剛經",
   "cbeta": null,
   "line": 22
  },
  {
   "text": "云何得長壽金剛不壞身…廣為眾生說(云何梵)",
   "attrib": "T0374 涅槃經",
   "cbeta": null,
   "line": 46
  },
  {
   "text": "何期自性本無動搖…即名丈夫天人師佛",
   "attrib": "T2008 六祖壇經",
   "cbeta": null,
   "line": 85
  },
  {
   "text": "直心是菩薩淨土…(十八心行全段)",
   "attrib": "T0475 維摩",
   "cbeta": null,
   "line": 212
  },
  {
   "text": "如來說莊嚴佛土者即非莊嚴…真是菩薩",
   "attrib": "T0235 金剛經",
   "cbeta": null,
   "line": 187
  },
  {
   "text": "心不住法而行布施…見種種色",
   "attrib": "T0235 金剛經",
   "cbeta": null,
   "line": 483
  },
  {
   "text": "一心不亂…即得往生阿彌陀佛極樂國土",
   "attrib": "T0366 阿彌陀經",
   "cbeta": null,
   "line": 327
  },
  {
   "text": "諸眾生中惟天與人…是故號佛為天人師",
   "attrib": "T0374 涅槃經",
   "cbeta": null,
   "line": 571
  },
  {
   "text": "窮釋子口稱貧…但自懷中解垢衣",
   "attrib": "T2014 證道歌",
   "cbeta": null,
   "line": 576
  },
  {
   "text": "從他謗任他非…恒沙諸佛體皆同",
   "attrib": "T2014 證道歌",
   "cbeta": null,
   "line": 617
  },
  {
   "text": "淨性比丘尼…心迹圓明悲欣交集",
   "attrib": "T0945 楞嚴經",
   "cbeta": null,
   "line": 151
  },
  {
   "text": "佛問圓通我無選擇都攝六根…名觀世音",
   "attrib": "T0945 楞嚴經",
   "cbeta": null,
   "line": 279
  },
  {
   "text": "若言如來及正解脫入於半字…(半字譬)",
   "attrib": "T0374 涅槃經",
   "cbeta": null,
   "line": 820
  },
  {
   "text": "諸法無相謂虛空相",
   "attrib": "T0848 大日經",
   "cbeta": null,
   "line": 349
  },
  {
   "text": "若菩薩捨一切煩惱名為檀波羅蜜…(六度)",
   "attrib": "T0586 思益經(經X1223引)",
   "cbeta": null,
   "line": 805
  },
  {
   "text": "云何忍辱？謂由三種行相應知。一、不忿怒，二、不報怨，三、不懷惡。",
   "attrib": "T1579 瑜伽師地論",
   "cbeta": null,
   "line": 600
  },
  {
   "text": "言尸羅者此方正翻名曰清涼…故號清涼",
   "attrib": "T1851 大乘義章",
   "cbeta": null,
   "line": 509
  },
  {
   "text": "如蛇行性曲入筒則直",
   "attrib": "T1848 起信論疏筆削記",
   "cbeta": null,
   "line": 308
  },
  {
   "text": "般若無知論…虛不失照照不失虛",
   "attrib": "T1858 肇論",
   "cbeta": null,
   "line": 751
  },
  {
   "text": "為諸眾生說是一切世間難信之法",
   "attrib": "T0366 阿彌陀經",
   "cbeta": null,
   "line": 234
  },
  {
   "text": "唯除五逆誹謗正法(第十八願)",
   "attrib": "T0360 無量壽經",
   "cbeta": null,
   "line": 162
  },
  {
   "text": "下品下生…五逆十惡…即得往生極樂世界",
   "attrib": "T0365 觀無量壽經",
   "cbeta": null,
   "line": 162
  },
  {
   "text": "如是寶積菩薩隨其直心則能發行…隨其心淨則佛土淨",
   "attrib": "T0475 維摩",
   "cbeta": null,
   "line": 985
  },
  {
   "text": "以無心意而現行/攝心/三無漏學(義)",
   "attrib": "T0945 楞嚴經",
   "cbeta": null,
   "line": 553
  }
 ],
