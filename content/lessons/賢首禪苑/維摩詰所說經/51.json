{
 "proof": [
  {
   "text": "是法平等，無有高下",
   "attrib": "金剛經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "心是根法是塵…痕垢盡除光始現",
   "attrib": "永嘉證道歌",
   "cbeta": null,
   "line": null
  },
  {
   "text": "汝猶未明一切浮塵諸幻化相",
   "attrib": "楞嚴經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "何期自性本自清淨…能生萬法",
   "attrib": "六祖壇經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "若欲入甚深法界及般若三昧者",
   "attrib": "六祖壇經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "非不非是不是…善星生陷墜",
   "attrib": "永嘉證道歌",
   "cbeta": null,
   "line": null
  },
  {
   "text": "絕學無為閒道人…無明實性即佛性",
   "attrib": "永嘉證道歌",
   "cbeta": null,
   "line": null
  },
  {
   "text": "阿鼻地獄四方有門",
   "attrib": "涅槃經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "貪欲是涅槃…以持戒狂故",
   "attrib": "諸法無行經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "我無選擇都攝六根，淨念相繼",
   "attrib": "楞嚴經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "此人無我相人相眾生相壽者相",
   "attrib": "金剛經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "皆令入無餘涅槃而滅度之",
   "attrib": "金剛經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "世為遷流，界為方位",
   "attrib": "楞嚴經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "是故空中無色無受想行識",
   "attrib": "心經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "云何為人演說不取於相",
   "attrib": "金剛經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "譬如清淨摩尼寶珠…身心幻垢",
   "attrib": "圓覺經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "應化非真佛亦非說法者/廣大第一常",
   "attrib": "彌勒偈(金剛經論)",
   "cbeta": null,
   "line": null
  },
  {
   "text": "菩提自性本來清淨",
   "attrib": "六祖壇經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "一切賢聖皆以無為法而有差別",
   "attrib": "金剛經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "諸凡夫人不能演說戒定慧者",
   "attrib": "涅槃經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "有八苾芻…吐血命終皆墮阿鼻大地獄中",
   "attrib": "寶授菩薩菩提行經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "若有所證即住如來相/說法無相是名說法",
   "attrib": "寶授菩薩菩提行經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "心地無非自性戒…(志誠戒定慧)",
   "attrib": "六祖壇經",
   "cbeta": null,
   "line": null
  },
  {
   "text": "法無頓漸人有利鈍",
   "attrib": "六祖壇經",
   "cbeta": null,
   "line": null
  }
 ],
