{
 "proof": [
  {
   "text": "汝欲見如來，為以何等觀如來乎",
   "attrib": "維摩詰所說經",
   "cbeta": null,
   "line": 331
  },
  {
   "text": "如自觀身實相，觀佛亦然…前際不來後際不去今則不住",
   "attrib": "維摩詰所說經",
   "cbeta": null,
   "line": 334
  },
  {
   "text": "不觀色…非四大起，同於虛空",
   "attrib": "維摩詰所說經",
   "cbeta": null,
   "line": 334
  },
  {
   "text": "六入無積…順三脫門，具足三明，與無明等",
   "attrib": "維摩詰所說經",
   "cbeta": null,
   "line": 342
  },
  {
   "text": "不一相不異相…不中流而化眾生",
   "attrib": "維摩詰所說經",
   "cbeta": null,
   "line": 345
  },
  {
   "text": "是經名為維摩詰所說，亦名不可思議解脫法門",
   "attrib": "維摩詰所說經(流通分)",
   "cbeta": null,
   "line": 15
  },
  {
   "text": "觀自在菩薩行深般若…度一切苦厄",
   "attrib": "心經",
   "cbeta": null,
   "line": 157
  },
  {
   "text": "色不異空，空不異色，色即是空，空即是色",
   "attrib": "心經",
   "cbeta": null,
   "line": 158
  },
  {
   "text": "是諸法空相，不生不滅…無智亦無得",
   "attrib": "心經",
   "cbeta": null,
   "line": 436
  },
  {
   "text": "以無所得故…三世諸佛…阿耨多羅三藐三菩提",
   "attrib": "心經",
   "cbeta": null,
   "line": 442
  },
  {
   "text": "凡所有相皆是虛妄，若見諸相非相則見如來",
   "attrib": "金剛經",
   "cbeta": null,
   "line": 454
  },
  {
   "text": "可以三十二相見如來不…即是非相是名三十二相",
   "attrib": "金剛經",
   "cbeta": null,
   "line": 519
  },
  {
   "text": "過去心不可得，現在心不可得，未來心不可得",
   "attrib": "金剛經",
   "cbeta": null,
   "line": 565
  },
  {
   "text": "若菩薩通達無我法者，如來說名真是菩薩",
   "attrib": "金剛經",
   "cbeta": null,
   "line": 698
  },
  {
   "text": "一切有為法如夢幻泡影，如露亦如電，應作如是觀",
   "attrib": "金剛經",
   "cbeta": null,
   "line": 930
  },
  {
   "text": "諸佛如來是法界身…是心作佛是心是佛",
   "attrib": "觀無量壽佛經",
   "cbeta": null,
   "line": 57
  },
  {
   "text": "言本有者，我本有父母和合之身…四百四病",
   "attrib": "大般涅槃經(金剛身品)",
   "cbeta": null,
   "line": 60
  },
  {
   "text": "修布施持戒忍辱精進禪定…是名知時…云何菩薩摩訶薩知足",
   "attrib": "大般涅槃經",
   "cbeta": null,
   "line": 111
  },
  {
   "text": "若眾生心憶佛念佛…不假方便自得心開…香光莊嚴",
   "attrib": "楞嚴經(念佛圓通章)",
   "cbeta": null,
   "line": 206
  },
  {
   "text": "有覺覺痛（畢陵伽婆蹉，卷五）",
   "attrib": "楞嚴經",
   "cbeta": null,
   "line": 902
  },
  {
   "text": "譬如大海不讓小流…皆得充滿",
   "attrib": "圓覺經",
   "cbeta": null,
   "line": 315
  },
  {
   "text": "假使有人純以七寶積滿三千大千…聞此經名及一句義",
   "attrib": "圓覺經",
   "cbeta": null,
   "line": 316
  },
  {
   "text": "一性圓通一切性…諸佛法身入我性…剎那滅却三祇劫",
   "attrib": "永嘉證道歌",
   "cbeta": null,
   "line": 735
  },
  {
   "text": "君不見絕學無為閑道人，不除妄想不求真",
   "attrib": "永嘉證道歌",
   "cbeta": null,
   "line": 185
  },
  {
   "text": "此偈未明心地…惠能沒伎倆…菩提作麼長",
   "attrib": "六祖壇經",
   "cbeta": null,
   "line": 756
  },
  {
   "text": "心地無非自性戒…不增不減自金剛，身去身來本三昧",
   "attrib": "六祖壇經",
   "cbeta": null,
   "line": 842
  },
  {
   "text": "凡所有相皆是虛妄…依此偈修免墮惡道…有大利益",
   "attrib": "六祖壇經",
   "cbeta": null,
   "line": 450
  },
  {
   "text": "三科法門者陰界入也…眼耳鼻舌身意是也",
   "attrib": "六祖壇經",
   "cbeta": null,
   "line": 606
  },
  {
   "text": "是以福德與功德別。武帝不識真理，非我祖師有過",
   "attrib": "六祖壇經",
   "cbeta": null,
   "line": 678
  },
  {
   "text": "假借四大以為身，心本無生因境有…罪福如幻起亦滅",
   "attrib": "毘舍浮佛偈",
   "cbeta": null,
   "line": 704
  },
  {
   "text": "一切諸法同一義，以修空故如實知，彼無種種別異相，於此一義已修學",
   "attrib": "月燈三昧經",
   "cbeta": null,
   "line": 257
  },
  {
   "text": "文殊殺佛偈(canon) 文殊大智慧…二事同一相…",
   "attrib": "如幻三昧經",
   "cbeta": null,
   "line": 661
  },
  {
   "text": "菩薩清涼月，常遊畢竟空，眾生心垢淨，菩提影現中",
   "attrib": "華嚴系偈頌",
   "cbeta": null,
   "line": 537
  }
 ],
